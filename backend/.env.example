GROQ_API_KEY=your_groq_api_key_here
# Groq retires models on a rolling schedule. When scanning returns a 503 naming
# the model, pick a current one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=sqlite:///./expenses.db

# Extra browser origins allowed to call this API (comma separated).
# Any localhost port is always allowed. Set this when you deploy the frontend.
CORS_ORIGINS=
